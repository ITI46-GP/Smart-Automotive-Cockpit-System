<RCC>
    <qresource prefix="/">
        <file alias="assets/BazelFrame.png">assets/BazelFrame.png</file>

        <!-- S5: the QNX target has NO fonts installed at all — `find / -name
             '*.ttf'` on the guest returns nothing, and there is no
             /usr/share/fonts or /qt/lib/fonts directory. Text would render
             with no usable family. Embedding the font in the binary is the
             right call for an embedded cluster anyway: no dependency on
             target filesystem state, no fontconfig discovery step, and the
             font cannot go missing on a reflashed image.

             Theme.fontPrimary is "Kdam Thmor Pro" and GaugeSpeedNumber also
             hardcodes it, so this single face covers everything S5 draws.
             Theme.fontSecondary ("Inter") is not referenced by any component
             ported so far — add it when one that uses it arrives, rather than
             embedding 16 unused Inter faces now. -->
        <file alias="fonts/KdamThmorPro-Regular.ttf">assets/fonts/KdamThmorPro-Regular.ttf</file>

        <!-- S7: BottomLayer icons. Same reasoning as the font — referenced by
             the unambiguous qrc alias rather than a relative path. -->
        <file alias="icons/fuel_icon_unselected.png">assets/icons/fuel_icon_unselected.png</file>
        <file alias="icons/engineTemp.png">assets/icons/engineTemp.png</file>

        <!-- S7.5: top bar icons. All downscaled 512x512 -> 96x96 offline by
             tools/gen_icons.py (they draw at 22-35 px); 185 KB -> 52 KB. -->
        <file alias="icons/car_icon.png">assets/icons/car_icon.png</file>
        <file alias="icons/car_icon_unselected.png">assets/icons/car_icon_unselected.png</file>
        <file alias="icons/contacts_icon_selected.png">assets/icons/contacts_icon_selected.png</file>
        <file alias="icons/contacts_icon_unselected.png">assets/icons/contacts_icon_unselected.png</file>
        <file alias="icons/fuel_icon_selected.png">assets/icons/fuel_icon_selected.png</file>
        <file alias="icons/music_icon_selected.png">assets/icons/music_icon_selected.png</file>
        <file alias="icons/music_icon_unselected.png">assets/icons/music_icon_unselected.png</file>
        <file alias="icons/navigation_icon_selected.png">assets/icons/navigation_icon_selected.png</file>
        <file alias="icons/navigation_icon_unselected.png">assets/icons/navigation_icon_unselected.png</file>
        <file alias="icons/settings_icon_selected.png">assets/icons/settings_icon_selected.png</file>
        <file alias="icons/settings_icon_unselected.png">assets/icons/settings_icon_unselected.png</file>
        <file alias="icons/left-arrow.png">assets/icons/left-arrow.png</file>
        <file alias="icons/right-arrow.png">assets/icons/right-arrow.png</file>

        <!-- S7: baked dial labels. 18 live Text items were ~8 batches / ~4 ms;
             as one Image each they are ~1. Generated by tools/gen_dial_labels.py. -->
        <file alias="art/DialLabelsSpeed.png">assets/DialLabelsSpeed.png</file>
        <file alias="art/DialLabelsRpm.png">assets/DialLabelsRpm.png</file>

        <!-- S8: car sprite with its drop shadow baked in (tools/gen_car.py),
             replacing a per-frame DesignEffect layer pass. Trimmed of ~40%
             transparent padding and scaled to near its display size. -->
        <file alias="art/CarWithShadow.png">assets/CarWithShadow.png</file>

        <!-- S9: the road's three STATIC layers baked into one image
             (tools/gen_road.py), replacing three paint-once Canvases. The
             three ANIMATED Canvases become Rectangles in Road.qml. -->
        <file alias="art/RoadBackdrop.png">assets/RoadBackdrop.png</file>

        <!-- Splash screen car (ported from 02-Digital-Cluster's
             assets/front_car.png verbatim, 843x499). One-time startup
             asset, not on the steady-state perf path. -->
        <file alias="art/SplashCar.png">assets/SplashCar.png</file>

        <!-- Production port: MapView's Canvas (grid+route+dot) baked by
             tools/gen_map.py (S1's one-time-Canvas-stall finding). -->
        <file alias="art/MapBackdrop.png">assets/MapBackdrop.png</file>

        <!-- Production port: MusicView mock cover art, copied in from the
             reference (was a fragile relative file:// path there). -->
        <file alias="art/MusicStarboy.jpeg">assets/MusicStarboy.jpeg</file>
        <file alias="art/MusicBeAlright.jpeg">assets/MusicBeAlright.jpeg</file>
        <file alias="art/MusicShots.png">assets/MusicShots.png</file>
    </qresource>
</RCC>
